{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile, balances, and bank card setup.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "phone": { "type": "string", "minLength": 5, "maxLength": 32 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "referralCode": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^[A-Z0-9_\\-]+$" },
        "referredBy": { "type": "string", "maxLength": 128 },
        "rechargeBalance": { "type": "number" },
        "withdrawalBalance": { "type": "number" },
        "invitedEarnings": { "type": "number" },
        "payoutMethod": {
          "type": "string",
          "enum": ["bKash", "Nagad", "Bank", "USDT-TRC20", "USDT-BEP20"]
        },
        "payoutAccount": { "type": "string", "maxLength": 128 },
        "bankHolderName": { "type": "string", "maxLength": 100 },
        "bankName": { "type": "string", "maxLength": 40 },
        "bankAccountNumber": { "type": "string", "maxLength": 128 },
        "bankCardVerified": { "type": "boolean" },
        "lastSalaryClaimDate": { "type": "string", "maxLength": 32 },
        "redeemedCodes": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "phone",
        "fullName",
        "referralCode",
        "rechargeBalance",
        "withdrawalBalance",
        "invitedEarnings",
        "payoutMethod",
        "bankCardVerified",
        "redeemedCodes",
        "createdAt"
      ]
    },
    "UserProduct": {
      "title": "UserProduct",
      "description": "Activated VIP automotive investment product with 24-hour claim cycle.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "planId": { "type": "string", "maxLength": 64 },
        "tier": { "type": "string", "maxLength": 32 },
        "modelName": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "dailyIncome": { "type": "number" },
        "totalIncome": { "type": "number" },
        "validityDays": { "type": "number" },
        "daysClaimed": { "type": "number" },
        "lastClaimedAt": { "type": "string", "format": "date-time" },
        "purchasedAt": { "type": "string", "format": "date-time" },
        "image": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["Active", "Completed"] }
      },
      "required": [
        "id",
        "userId",
        "planId",
        "tier",
        "modelName",
        "price",
        "dailyIncome",
        "totalIncome",
        "validityDays",
        "daysClaimed",
        "purchasedAt",
        "status"
      ]
    },
    "TransactionRecord": {
      "title": "TransactionRecord",
      "description": "Immutable financial ledger record for user deposits, withdrawals, investments, and payouts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": {
          "type": "string",
          "enum": [
            "Recharge",
            "Withdraw",
            "Investment",
            "Daily Income",
            "Referral Bonus",
            "Registration Bonus",
            "Gift Code",
            "Daily Salary"
          ]
        },
        "amount": { "type": "number" },
        "method": { "type": "string", "maxLength": 40 },
        "channel": { "type": "string", "maxLength": 64 },
        "accountRef": { "type": "string", "maxLength": 128 },
        "txId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["Completed", "Processing", "Rejected"] },
        "note": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "amount", "status", "note", "createdAt"]
    },
    "DepositRequest": {
      "title": "DepositRequest",
      "description": "Send Money recharge request awaiting admin confirmation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userPhone": { "type": "string", "maxLength": 32 },
        "userName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "bonusAmount": { "type": "number" },
        "method": { "type": "string", "maxLength": 40 },
        "channel": { "type": "string", "maxLength": 64 },
        "txId": { "type": "string", "minLength": 4, "maxLength": 128 },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "userPhone",
        "userName",
        "amount",
        "bonusAmount",
        "method",
        "channel",
        "txId",
        "status",
        "createdAt"
      ]
    },
    "WithdrawRequest": {
      "title": "WithdrawRequest",
      "description": "User withdrawal request after package purchase and bank card verification.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userPhone": { "type": "string", "maxLength": 32 },
        "userName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "method": {
          "type": "string",
          "enum": ["bKash", "Nagad", "Bank", "USDT-TRC20", "USDT-BEP20"]
        },
        "accountNumber": { "type": "string", "minLength": 4, "maxLength": 128 },
        "bankHolderName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "bankName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "type": "string", "enum": ["Processing", "Approved", "Rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "userPhone",
        "userName",
        "amount",
        "method",
        "accountNumber",
        "bankHolderName",
        "bankName",
        "status",
        "createdAt"
      ]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Live app configuration for Telegram links, bonus, VIP plans, and active payment numbers.",
      "type": "object",
      "properties": {
        "telegramGroupUrl": { "type": "string", "maxLength": 300 },
        "supportUrl": { "type": "string", "maxLength": 300 },
        "welcomeNotice": { "type": "string", "maxLength": 500 },
        "registrationBonus": { "type": "number" },
        "paymentNumbers": { "type": "array" },
        "vipPlans": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "telegramGroupUrl",
        "supportUrl",
        "welcomeNotice",
        "registrationBonus",
        "paymentNumbers"
      ]
    },
    "ReferralIndex": {
      "title": "ReferralIndex",
      "description": "Public non-PII referral code mapping to owner UID.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referralCode": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^[A-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "referralCode", "createdAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Database-backed admin authorization record.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User private profile, balances, and bank card binding."
    },
    "/users/{userId}/products/{productId}": {
      "schema": { "$ref": "#/entities/UserProduct" },
      "description": "User activated VIP products."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/TransactionRecord" },
      "description": "User wallet transaction records."
    },
    "/deposits/{depositId}": {
      "schema": { "$ref": "#/entities/DepositRequest" },
      "description": "Pending and confirmed deposit requests."
    },
    "/withdrawals/{withdrawId}": {
      "schema": { "$ref": "#/entities/WithdrawRequest" },
      "description": "User withdrawal requests."
    },
    "/config/{configId}": {
      "schema": { "$ref": "#/entities/AppConfig" },
      "description": "Global live app settings and payment numbers."
    },
    "/referrals/{referralCode}": {
      "schema": { "$ref": "#/entities/ReferralIndex" },
      "description": "Non-PII referral code ownership lookup."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Admin role records."
    }
  }
}
